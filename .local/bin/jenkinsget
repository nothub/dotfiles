#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

usage() {
    cat << 'EOF'
Usage: jenkinsget <command> <url> [args]

Read state, logs and artifacts of Jenkins pipeline builds behind CES CAS.

Commands:
  status   <build-url>              Build summary as JSON (state, progress, stages)
  builds   <job-url> [count]        Recent builds as JSON (default count: 10)
  branch   <project> <branch> [count]
                                    Same as builds, with the job URL built from
                                    JENKINSGET_ORG_URL, project and branch
  log      <build-url> [start]      Console log; with start, only bytes from that
                                    offset on. Prints "next-start=N more-data=B"
                                    to stderr for incremental reads.
  artifacts <build-url>             List artifact paths, one per line
  artifact <build-url> <path> [out] Download one artifact to out (default: stdout)

A build URL is a job URL plus a build number, or plus lastBuild,
lastSuccessfulBuild, lastFailedBuild, ...:
  https://ecosystem.cloudogu.com/jenkins/job/cloudogu-github/job/cockpit/job/classic_pipeline/167/

JENKINSGET_ORG_URL defaults to
  https://ecosystem.cloudogu.com/jenkins/job/cloudogu-github

Credentials come from CAS_USERNAME and CAS_PASSWORD. If they are unset,
the script sources JENKINSGET_ENV (default: ${XDG_CONFIG_HOME:-~/.config}/ces.env).

Exit codes: 0 ok, 2 usage error, otherwise curl's exit code
(22 = HTTP error such as 401 or 404).
EOF
}

die_usage() {
    echo "jenkinsget: $1" >&2
    echo "Try 'jenkinsget --help'." >&2
    exit 2
}

load_credentials() {
    if test -z "${CAS_USERNAME:-}" || test -z "${CAS_PASSWORD:-}"; then
        local env_file="${JENKINSGET_ENV:-${XDG_CONFIG_HOME:-${HOME}/.config}/ces.env}"
        # shellcheck source=/dev/null
        . "${env_file}"
    fi
    if test -z "${CAS_USERNAME:-}" || test -z "${CAS_PASSWORD:-}"; then
        echo "jenkinsget: CAS_USERNAME and CAS_PASSWORD are required" >&2
        exit 2
    fi
}

# The Jenkins CAS plugin accepts basic auth and checks it against CAS.
# Credentials go through a curl config on stdin, so they never show up in
# the process list. Config strings need backslash and double quote escaped.
jcurl() {
    local user="${CAS_USERNAME}:${CAS_PASSWORD}"
    user="${user//\\/\\\\}"
    user="${user//\"/\\\"}"
    printf 'user = "%s"\n' "${user}" \
        | curl --config - --globoff --silent --show-error --fail --location "$@"
}

trim_url() {
    printf '%s' "${1%/}"
}

cmd_status() {
    local url
    url="$(trim_url "$1")"
    local run stages
    run="$(jcurl "${url}/api/json?tree=number,url,building,result,timestamp,duration,estimatedDuration,artifacts[relativePath]")"
    stages="$(jcurl "${url}/wfapi/describe")"
    jq --null-input \
        --argjson run "${run}" \
        --argjson wf "${stages}" \
        --argjson now "$(date +%s%3N)" \
        '
        ($run.building) as $building
        | (if $building then $now - $run.timestamp else $run.duration end) as $elapsed
        | {
            number: $run.number,
            url: $run.url,
            finished: ($building | not),
            result: $run.result,
            status: $wf.status,
            startedAt: ($run.timestamp / 1000 | todate),
            elapsedSeconds: ($elapsed / 1000 | floor),
            estimatedSeconds: ($run.estimatedDuration / 1000 | floor),
            progressPercent: (
                if ($building | not) then 100
                elif $run.estimatedDuration > 0 then [($elapsed * 100 / $run.estimatedDuration | floor), 99] | min
                else null end
            ),
            stages: [$wf.stages[] | {id, name, status, seconds: (.durationMillis / 1000 | floor)}],
            artifactCount: ($run.artifacts | length)
        }'
}

cmd_builds() {
    local url count
    url="$(trim_url "$1")"
    count="${2:-10}"
    # Only SCMRevisionAction names the commit the build is for. BuildData
    # exists once per checkout, shared libraries included. Pull requests
    # carry their head commit in pullHash.
    jcurl "${url}/api/json?tree=builds[number,building,result,timestamp,url,actions[revision[hash,pullHash]]]{0,${count}}" \
        | jq '[.builds[] | {
            number,
            finished: (.building | not),
            result,
            startedAt: (.timestamp / 1000 | todate),
            commit: ([.actions[].revision | select(.) | .pullHash // .hash] | first),
            url
        }]'
}

# Multibranch jobs name branches with "/" encoded as %2F, which the URL
# encodes once more: feature/x -> job/feature%252Fx.
cmd_branch() {
    local org project branch
    org="$(trim_url "${JENKINSGET_ORG_URL:-https://ecosystem.cloudogu.com/jenkins/job/cloudogu-github}")"
    project="$(jq --raw-input --raw-output '@uri' <<< "$1")"
    branch="$(jq --raw-input --raw-output '@uri' <<< "$2")"
    cmd_builds "${org}/job/${project}/job/${branch//%/%25}" "${@:3}"
}

cmd_log() {
    local url
    url="$(trim_url "$1")"
    if test "$#" -lt 2; then
        jcurl "${url}/consoleText"
        return
    fi

    local headers
    headers="$(mktemp)"
    # shellcheck disable=SC2064 # expand now, the variable is local
    trap "rm -f '${headers}'" RETURN
    jcurl --dump-header "${headers}" "${url}/logText/progressiveText?start=$2"
    local size more
    size="$(tr -d '\r' < "${headers}" | awk -F': ' 'tolower($1) == "x-text-size" { print $2 }')"
    more="$(tr -d '\r' < "${headers}" | awk -F': ' 'tolower($1) == "x-more-data" { print $2 }')"
    echo "next-start=${size} more-data=${more:-false}" >&2
}

cmd_artifacts() {
    local url
    url="$(trim_url "$1")"
    jcurl "${url}/api/json?tree=artifacts[relativePath]" | jq --raw-output '.artifacts[].relativePath'
}

cmd_artifact() {
    local url path
    url="$(trim_url "$1")"
    path="$(jq --raw-input --raw-output '@uri' <<< "$2")"
    # @uri also encodes "/", which Jenkins needs as separator.
    path="${path//%2F//}"
    if test "$#" -ge 3; then
        jcurl --output "$3" "${url}/artifact/${path}"
    else
        jcurl "${url}/artifact/${path}"
    fi
}

main() {
    if test "$#" -eq 0; then
        usage >&2
        exit 2
    fi

    local command="$1"
    shift
    case "${command}" in
        -h | --help | help)
            usage
            exit 0
            ;;
        status | artifacts) test "$#" -eq 1 || die_usage "${command} takes <build-url>" ;;
        builds) { test "$#" -ge 1 && test "$#" -le 2; } || die_usage "builds takes <job-url> [count]" ;;
        branch) { test "$#" -ge 2 && test "$#" -le 3; } || die_usage "branch takes <project> <branch> [count]" ;;
        log) { test "$#" -ge 1 && test "$#" -le 2; } || die_usage "log takes <build-url> [start]" ;;
        artifact) { test "$#" -ge 2 && test "$#" -le 3; } || die_usage "artifact takes <build-url> <path> [out]" ;;
        *) die_usage "unknown command '${command}'" ;;
    esac

    load_credentials
    "cmd_${command}" "$@"
}

main "$@"
