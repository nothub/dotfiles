#!/usr/bin/env bash

set -eu -o pipefail

set_key() {
    xfconf-query --channel xfce4-keyboard-shortcuts --property "$1" --reset
    xfconf-query --channel xfce4-keyboard-shortcuts --property "$1" \
        --create --type string --set "$2"
}

set_key '/commands/custom/<Super>f' 'exo-open --launch FileManager'
set_key '/commands/custom/<Super>m' 'exo-open --launch MailReader'
set_key '/commands/custom/<Super>w' 'exo-open --launch WebBrowser'
set_key '/commands/custom/<Super>t' 'exo-open --launch TerminalEmulator'
set_key '/commands/custom/<Super>Return' 'exo-open --launch TerminalEmulator'

set_key '/commands/custom/<Super>l' 'xflock4'
set_key '/commands/custom/<Super>p' 'xfce4-display-settings --minimal'

set_key '/xfwm4/custom/<Super>KP_1' 'tile_down_left_key'
set_key '/xfwm4/custom/<Super>KP_2' 'tile_down_key'
set_key '/xfwm4/custom/<Super>KP_3' 'tile_down_right_key'
set_key '/xfwm4/custom/<Super>KP_4' 'tile_left_key'
set_key '/xfwm4/custom/<Super>KP_5' 'maximize_window_key'
set_key '/xfwm4/custom/<Super>KP_6' 'tile_right_key'
set_key '/xfwm4/custom/<Super>KP_7' 'tile_up_left_key'
set_key '/xfwm4/custom/<Super>KP_8' 'tile_up_key'
set_key '/xfwm4/custom/<Super>KP_9' 'tile_up_right_key'
