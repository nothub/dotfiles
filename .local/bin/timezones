#!/usr/bin/env sh

set -eu

tzdate() {
    printf "%-5s %-9s %s\n" \
        "$(TZ="$1" date "+%Z")" \
        "$(TZ="$1" date "+%H:%M:%S")" \
        "$1"
}

tzdate "Pacific/Honolulu"
tzdate "America/Los_Angeles"
tzdate "America/Mexico_City"
tzdate "America/New_York"
tzdate "America/Noronha"
tzdate "Africa/Accra"
tzdate "Europe/London"
tzdate "Europe/Berlin"
tzdate "Asia/Jerusalem"
tzdate "Asia/Dubai"
tzdate "Asia/Kolkata"
tzdate "Asia/Shanghai"
tzdate "Asia/Tokyo"
tzdate "Australia/Sydney"
tzdate "Pacific/Fiji"
