#!/usr/bin/env bash

set -o errexit
set -o pipefail

if test -z "$1" || test ! -r "$1" \
    || test -z "$2" || test ! -r "$2"; then
    echo >&2 "Usage: $(basename "${BASH_SOURCE[0]}") <path> <path>"
    exit 2
fi

a=$(sha256sum "$1")
b=$(sha256sum "$2")

echo "${a}" >&2
echo "${b}" >&2

if test "${a/$1/}" = "${b/$2/}"; then
    echo "OK"
else
    exit 1
fi
