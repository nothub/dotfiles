#!/usr/bin/env sh

# Control X220 ThinkLight with a simple script.

ledFile="/sys/devices/platform/thinkpad_acpi/leds/tpacpi\:\:thinklight/brightness"
ledValue=$(cat "$ledFile")

if test -z ${1+x}; then

    if test $ledValue -eq 0; then
        echo 1 > $ledFile
    elif test $ledValue -gt 0; then
        echo 0 > $ledFile
    else
        echo "something went wrong! '$ledValue' '$ledFile'"
    fi

else

    if test $1 -eq 0; then
        echo 0 > $ledFile
    elif test $1 -gt 0; then
        echo 1 > $ledFile
    else
        echo "something went wrong! '$ledValue' '$ledFile'"
    fi

fi
